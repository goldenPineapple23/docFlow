# DocFlow — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env` itself.
# See SETUP.md for exactly where each value comes from.

# ── Environment ──────────────────────────────────────────────────────────
# "staging" until Phase 6; "production" only once docflow-prod exists.
DOCFLOW_ENV=staging
APP_BASE_URL=http://localhost:3000

# Origins the browser app is served from, comma-separated. The API and the
# web app are always separate origins, so the browser refuses every call
# without this. Add your deployed web origin here when you deploy.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_BASE_URL=http://localhost:8000

# ── Supabase (docflow-staging project) — SETUP.md Step 1 ────────────────
SUPABASE_URL=
# The "Publishable key" (sb_publishable_...) from Project Settings -> API Keys.
# Newer Supabase projects show this instead of a JWT-based "anon" key -- either
# works with the JS client, this is just what's current.
SUPABASE_ANON_KEY=
# Same two values, re-exposed with the NEXT_PUBLIC_ prefix Next.js requires
# for anything read in browser-side code (the login page's Supabase client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# The "Secret key" (sb_secret_...) from the same page. Full DB/Auth-admin access.
# Backend/worker only. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled ("transaction mode") connection string from Project Settings -> Database,
# edited to log in as the "docflow_app" role (NOT "postgres") -- see SETUP.md Step 1.6.
# "postgres" bypasses RLS entirely, which would make tenant isolation a no-op.
# Used by both the FastAPI app and the Celery workers -- never a per-request raw connection.
DATABASE_URL=

# ── Supabase Storage (Stage 3b) ─────────────────────────────────────────────
# DocFlow's files live in the private bucket `docflow-files` (migration 0033),
# reached through Storage's S3-compatible endpoint with an access key that
# reaches Storage and nothing else -- never the secret key above.
# Supabase dashboard -> Storage -> S3 Configuration (project settings):
#   STORAGE_S3_ENDPOINT: the "Endpoint", https://<project_ref>.storage.supabase.co/storage/v1/s3
#   STORAGE_S3_REGION:   the "Region" shown on the same page (the project's region)
#   and "New access key" for the other two. The secret is shown once.
# The key is project-wide and bypasses RLS: tenant isolation for files is
# docflow_core.storage's own prefix check. Backend/worker only. NEVER expose.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# The pre-3b local folder. Only scripts/copy_storage_to_bucket.py reads it now.
# STORAGE_ROOT=storage
# LEAVE BLANK. HS256 is being retired (DECISIONS.md D-174): with this blank the
# backend verifies sign-ins against the project's published public keys (JWKS),
# which needs no secret. A filled-in legacy secret would let anyone holding it
# create a sign-in token for any user. Removed entirely in Phase 6.
SUPABASE_JWT_SECRET=
# Console MFA (DECISIONS.md D-151, D-177). false until the founder has enrolled
# an authenticator and passed a challenge; then true, and it stays true.
# docflow-prod is never deployed with this false after enrolment (RUNBOOK 4).
CONSOLE_MFA_ENFORCED=false

# ── Anthropic (extraction) — SETUP.md Step 2 ─────────────────────────────
ANTHROPIC_API_KEY=
# Pinned model IDs -- verify against current Anthropic docs before changing (CLAUDE.md Section 3).
DOCFLOW_EXTRACTION_MODEL=claude-sonnet-5
DOCFLOW_ROUTING_MODEL=claude-haiku-4-5-20251001

# ── Stripe (test mode until Phase 6) — SETUP.md Step 3 ───────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Filled in during Phase 5 once a webhook endpoint exists.
STRIPE_WEBHOOK_SECRET=

# ── Job queue ─────────────────────────────────────────────────────────────
# Local Redis for development; a managed Redis add-on (Railway/Render) once deployed.
# Any Redis-protocol server works -- Memurai on Windows, a Docker container,
# or a managed instance. Nothing in the code is tied to one; this URL is the
# only thing that changes between them.
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 (::1) first and
# waits ~2 s per connection before falling back (found in slice 5.9).
REDIS_URL=redis://127.0.0.1:6379/0

# ── Document viewer URLs ──────────────────────────────────────────────────
# Signs the short-lived URLs the review screen loads the original document
# from (CLAUDE.md Section 7.4 / 7.12). Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates in-flight viewer URLs and nothing else -- it signs
# no sessions, so rotation never signs anyone out.
DOCUMENT_URL_SIGNING_SECRET=

# ── Email intake / notifications ─────────────────────────────────────────
# Postmark (see DECISIONS.md for why, over Resend) -- its inbound webhook
# posts to POST /intake/email/{token} (apps/api/app/routers/email_intake.py).
# No Postmark account exists yet as of this slice; creating one and pointing
# its inbound webhook at this endpoint is a manual step for later, once
# there's a real domain to receive mail at (see SETUP.md Step 5).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=notifications@docflow.example
# Domain used to generate per-tenant intake addresses, e.g. orders+<token>@mail.docflow.example
INTAKE_EMAIL_DOMAIN=mail.docflow.example

# The inbound webhook's own credentials (review finding H8). The per-tenant
# token in the intake URL says WHICH TENANT; it is the local part of an address
# customers hand to their buyers, so it is public by design and cannot also be
# the authentication. Postmark carries these as HTTP Basic credentials on the
# webhook URL: https://USER:PASS@api.docflow.example/intake/email/{token}
#
# **Blank refuses all inbound mail.** That is deliberate -- a missing variable
# must not silently fall back to token-only -- so set these BEFORE pointing
# Postmark here. RUNBOOK section 2 has the cutover order and the rotation
# procedure. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTMARK_WEBHOOK_USERNAME=
POSTMARK_WEBHOOK_PASSWORD=
# Comma-separated source addresses Postmark posts from. LOG-ONLY, never
# enforcing, until confirmed against Postmark's published list by the RUNBOOK
# section 2 procedure (D-155): an allowlist enforced on a guess drops real
# purchase orders. Blank means nothing is logged about the source.
POSTMARK_INBOUND_IP_ALLOWLIST=

# ── Founder alerting (CLAUDE.md Section 7.9) ─────────────────────────────
FOUNDER_ALERT_EMAIL=

# ── Customer support ──────────────────────────────────────────────────────
# The address customers email -- to cancel, among other things. Shown in the
# card-billing emails ("To cancel, email ..."); "Ask for a card" refuses while
# it is blank (ONB-018). A mailbox someone reads: RUNBOOK section 3.
SUPPORT_EMAIL=

# ── Observability (Phase 6) ───────────────────────────────────────────────
SENTRY_DSN=
LLM_OBSERVABILITY_API_KEY=

# ── App secrets ───────────────────────────────────────────────────────────
# Random long string used to sign session cookies. Generate with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ── Worker sandboxing (CLAUDE.md Section 7.11 / DECISIONS.md D-003) ──────
# Comma-separated allowlist of outbound hosts the parsing worker service may reach.
# Enforced at the service/network boundary, not per-subprocess -- see DECISIONS.md D-003.
WORKER_EGRESS_ALLOWLIST=api.anthropic.com,*.supabase.co

# ── The parse service (Stage 3c) ────────────────────────────────────────
# Since Stage 3c the worker never opens a file: it sends the bytes to the
# parse service (apps/parse), which opens each one in a sandboxed job of its
# own. Dev: start it with `python -m parse_service.server` in apps/parse
# (SETUP.md Step 7); it listens on 127.0.0.1:8100. On Fly: the parse app's
# private Flycast address, e.g. http://docflow-parse-staging.flycast.
PARSE_SERVICE_URL=http://127.0.0.1:8100
# Shared by the worker and the parse service only (founder, Q2). Any long
# random string; the same value on both. Required in production mode, where
# the service refuses to start without one. Blank in dev means no token.
# Never on the API: on Fly the API refuses to start with it set (Q12), and
# in dev leave it blank here, since the API reads this file too
# (apps/api/tests/test_parse_token_boundary.py fails otherwise).
PARSE_SERVICE_TOKEN=
# FLY_APP_NAME is set by Fly on every machine and never here. It is how the
# parse service and the API know they are deployed.

# ── The dispatcher (Stage 3d) ─────────────────────────────────────────────
# How many documents may be in flight (on the queue or being read) across all
# tenants: the worker's document slots. The worker's Celery concurrency is
# set from it (plus one process for the dispatch pass and the sweeps), so the
# two can't drift. Staging: 1. Raise it with the worker (RUNBOOK 9.2).
DISPATCH_IN_FLIGHT_TARGET=1

# ── Tier 2 conversion (CLAUDE.md Section 7.11 / DECISIONS.md D-041) ──────
# Full path to the LibreOffice binary (soffice.exe / soffice), used by the
# parse service (dev mode on this machine) to convert legacy binary .doc
# files before reading them. Read from the parse service's own environment.
# Leave blank to look on PATH and in the usual install locations. If
# LibreOffice isn't installed at all, .doc documents fail cleanly with
# catalog code DOC-017 -- every other format is unaffected. See SETUP.md
# Step 7. A hosted conversion service is never an option (Section 7.10).
LIBREOFFICE_PATH=
