# DocFlow — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env` itself.
# See SETUP.md for exactly where each value comes from.

# ── Environment ──────────────────────────────────────────────────────────
# "staging" until Phase 6; "production" only once docflow-prod exists.
DOCFLOW_ENV=staging
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ── Supabase (docflow-staging project) — SETUP.md Step 1 ────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Same two values, re-exposed with the NEXT_PUBLIC_ prefix Next.js requires
# for anything read in browser-side code (the login page's Supabase client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Service role key: full DB access, bypasses RLS. Backend/worker only. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled ("transaction mode") connection string from Project Settings -> Database,
# edited to log in as the "docflow_app" role (NOT "postgres") -- see SETUP.md Step 1.6.
# "postgres" bypasses RLS entirely, which would make tenant isolation a no-op.
# Used by both the FastAPI app and the Celery workers -- never a per-request raw connection.
DATABASE_URL=
# Project Settings -> API -> JWT Secret. Used by the backend to verify Supabase Auth session tokens.
SUPABASE_JWT_SECRET=

# ── Anthropic (extraction) — SETUP.md Step 2 ─────────────────────────────
ANTHROPIC_API_KEY=
# Pinned model IDs -- verify against current Anthropic docs before changing (CLAUDE.md Section 3).
DOCFLOW_EXTRACTION_MODEL=claude-sonnet-5
DOCFLOW_ROUTING_MODEL=claude-haiku-4-5-20251001

# ── Stripe (test mode until Phase 6) — SETUP.md Step 3 ───────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Filled in during Phase 5 once a webhook endpoint exists.
STRIPE_WEBHOOK_SECRET=

# ── Job queue ─────────────────────────────────────────────────────────────
# Local Redis for development; a managed Redis add-on (Railway/Render) once deployed.
REDIS_URL=redis://localhost:6379/0

# ── Email intake / notifications ─────────────────────────────────────────
# Resend or Postmark -- set up in Phase 1 when email intake is built.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=notifications@docflow.example
# Domain used to generate per-tenant intake addresses, e.g. orders+<token>@mail.docflow.example
INTAKE_EMAIL_DOMAIN=mail.docflow.example

# ── Founder alerting (CLAUDE.md Section 7.9) ─────────────────────────────
FOUNDER_ALERT_EMAIL=

# ── Observability (Phase 6) ───────────────────────────────────────────────
SENTRY_DSN=
LLM_OBSERVABILITY_API_KEY=

# ── App secrets ───────────────────────────────────────────────────────────
# Random long string used to sign session cookies. Generate with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ── Worker sandboxing (CLAUDE.md Section 7.11 / DECISIONS.md D-003) ──────
# Comma-separated allowlist of outbound hosts the parsing worker service may reach.
# Enforced at the service/network boundary, not per-subprocess -- see DECISIONS.md D-003.
WORKER_EGRESS_ALLOWLIST=api.anthropic.com,*.supabase.co
